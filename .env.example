# ============================================
# ActivityDMS — Environment Configuration (TEMPLATE)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง
# ห้าม commit .env (อยู่ใน .gitignore แล้ว)
# ============================================

# --- Application ---
APP_NAME="ActivityDMS"
APP_ENV=dev                       # dev | prod
APP_DEBUG=true                    # prod = false (ปิด error display)
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok         # ห้ามลบ — กระทบปีงบประมาณ

# --- Database (MySQL 8.x) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=activitydms
DB_USER=root
DB_PASSWORD=admin                     # ใส่รหัสผ่าน DB จริงใน .env (อย่า commit)
DB_CHARSET=utf8mb4                # ห้ามแก้ — ภาษาไทย + emoji

# --- Mail / SMTP (PHPMailer) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                    # บัญชี SMTP ของคุณ
MAIL_PASSWORD=                    # Gmail ใช้ App Password 16 หลัก (ไม่มี space)
MAIL_ENCRYPTION=tls               # tls (587) | ssl (465)
MAIL_FROM_ADDRESS=noreply@arit.example.ac.th
MAIL_FROM_NAME="ActivityDMS - ARIT"

# Email queue (สเปค §7.5)
MAIL_RATE_LIMIT_PER_HOUR=50
MAIL_MAX_RETRY=3

# --- Upload ---
# absolute path นอก document root (CLAUDE.md ข้อ 9)
# Windows + Linux ใช้ forward slash ได้ทั้งคู่
# ตัวอย่าง Windows: D:/activitydms-uploads  •  Linux: /var/www/activitydms-uploads
UPLOAD_PATH=/path/to/activitydms-uploads
UPLOAD_MAX_DOC_MB=10
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_CERT_PDF_MB=10
UPLOAD_MAX_CERT_IMAGE_MB=5

# --- Session / Security (สเปค §7.1) ---
SESSION_NAME=ADMS_SESSID
SESSION_LIFETIME=1800             # 30 นาที — ห้ามแก้ตามสเปค
SESSION_SECURE_COOKIE=false       # prod + HTTPS = true
SESSION_SAMESITE=Lax

# --- CSRF ---
CSRF_TOKEN_NAME=adms_csrf
